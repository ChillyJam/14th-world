# Copy to .env and adjust. All values shown are the defaults.
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/world.db
# Ticks per real second; one tick is one in-world minute.
# 10 Hz => one in-world day every 2.4 minutes.
TICK_RATE_HZ=10
SNAPSHOT_INTERVAL_SECS=60
SNAPSHOTS_TO_KEEP=24
# Seed for a brand-new world. Ignored once a world exists in the database.
# WORLD_SEED=42
RUST_LOG=info,sqlx=warn
